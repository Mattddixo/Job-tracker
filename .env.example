# Copy this file to .env and fill in real values. Never commit .env.

# --- Postgres ---
POSTGRES_DB=homejobs
POSTGRES_USER=homejobs
POSTGRES_PASSWORD=change-me-to-a-strong-password

# --- Backend API ---
# Port the API listens on inside its container (and is exposed on the host
# unless you put a reverse proxy in front, in which case only expose it to
# the proxy network).
HTTP_PORT=8080

# Static API key clients must send as: Authorization: Bearer <API_KEY>
# Generate one with: openssl rand -hex 32
API_KEY=change-me-to-a-long-random-secret

# Allowed origin for browser-based clients, if any (leave unset to disable CORS).
CORS_ALLOWED_HOST=

# Directory (inside the container) where job photo attachments are stored.
ATTACHMENTS_DIR=/data/attachments
