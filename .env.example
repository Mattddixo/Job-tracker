# Copy this file to .env and fill in real values. Never commit .env.

# --- Postgres ---
POSTGRES_DB=homejobs
POSTGRES_USER=homejobs
POSTGRES_PASSWORD=change-me-to-a-strong-password

# --- Backend API ---
# Port the API listens on, both inside the container and on the host.
HTTP_PORT=8080

# Host address docker-compose binds HTTP_PORT to. Defaults to loopback only
# (127.0.0.1 — not reachable from any other machine). Set this to your
# Tailscale IP (run `tailscale ip -4` on the server) to expose the API only
# on the tailnet, or to 0.0.0.0 to expose it on every interface (only do
# that if you're putting a reverse proxy in front, e.g. Caddy/Traefik).
BIND_ADDRESS=127.0.0.1

# Static API key clients must send as: Authorization: Bearer <API_KEY>
# Generate one with: openssl rand -hex 32
API_KEY=change-me-to-a-long-random-secret

# Allowed origin for browser-based clients, if any (leave unset to disable CORS).
CORS_ALLOWED_HOST=

# Directory (inside the container) where job photo attachments are stored.
ATTACHMENTS_DIR=/data/attachments
